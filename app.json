{
  "expo": {
    "name": "Apni Sawari",
    "slug": "apni-sawari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "apni-sawari",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E96E5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.apnisawari.app",
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to find nearby drivers and show your position on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location to track your ride in real-time.",
        "NSCameraUsageDescription": "We need camera access to take parcel photos for courier rides."
      }
    },
    "android": {
      "package": "com.apnisawari.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E96E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_KEY"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Apni Sawari to use your location for ride tracking."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Apni Sawari to access your camera for parcel photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1E96E5"
        }
      ]
    ]
  }
}
